            35
          ],
          "ko_range": [
            0,
            16
          ],
          "source_text": "ἐξῆλθον εἰς συνάντησιν τῷ ἀλλοφύλῳ,",
          "ko_text": "나는 이방인을 맞으러 나갔고,"
        },
        {
          "id": "a-a30de28b3a06650aa100",
          "source_range": [
            36,
            80
          ],
          "ko_range": [
